# =============================================================================
# Dayjoy Fit90 — credentials & configuration checklist
# =============================================================================
# This file lists every private credential the app needs when you switch it
# from DEMO mode to the real backend. NONE of these are needed to run the demo.
#
# IMPORTANT for a non-technical owner:
#   * These values are NOT typed into this file to make the app work. Firebase
#     credentials live in generated native files (google-services.json,
#     GoogleService-Info.plist, lib/firebase_options.dart). This file is your
#     checklist of what to obtain and hand to your developer.
#   * Never share the real values publicly or commit them to a public repo.
#
# Copy this file to ".env" for your own notes if you like — the app does not
# read it, so it can never crash from a missing value.
# =============================================================================

# --- Firebase project (from console.firebase.google.com) ---------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_ANDROID_APP_ID=1:0000000000:android:xxxxxxxxxxxx
FIREBASE_IOS_APP_ID=1:0000000000:ios:xxxxxxxxxxxx
FIREBASE_WEB_API_KEY=AIza...redacted...
# Provided as files, not text:
#   Android -> android/app/google-services.json
#   iOS     -> ios/Runner/GoogleService-Info.plist
#   Dart    -> lib/firebase_options.dart   (generated by `flutterfire configure`)

# --- Phone OTP (Firebase Authentication -> Phone provider) -------------------
# Android: add your app's SHA-1 / SHA-256 fingerprints in the Firebase console.
# iOS:     upload the APNs Auth Key (.p8) under Cloud Messaging.
OTP_TEST_PHONE_NUMBER=+91 90000 00000
OTP_TEST_CODE=123456

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
# APNs .p8 key file is uploaded to Firebase, not stored here.

# --- Apple (for iOS builds / App Store) --------------------------------------
APPLE_TEAM_ID=XXXXXXXXXX
IOS_BUNDLE_ID=com.dayjoy.fit90

# --- Cloud storage bucket (Firebase Storage, auto-created with the project) --
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Backend API base URL (Cloud Functions region host) ----------------------
BACKEND_REGION=asia-south1

# --- CI/CD (GitHub Actions release) — set as GitHub Secrets, not here --------
# ANDROID_KEYSTORE_BASE64, ANDROID_STORE_PASSWORD, ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD, FIREBASE_TOKEN  (see docs/ci_cd.md)
